  <!-- Controle do LOADER — fora do app.js de propósito, pra funcionar
       mesmo se o app.js falhar ao carregar. -->
  <script>
    (function () {
      var loader = document.getElementById('loader');
      var shownAt = Date.now();
      var MIN_MS = 900, MAX_MS = 5000;
      function hide() {
        if (!loader || loader.classList.contains('hide')) return;
        loader.classList.add('hide');
        setTimeout(function () { loader.remove(); }, 900);
      }
      window.addEventListener('load', function () {
        setTimeout(hide, Math.max(0, MIN_MS - (Date.now() - shownAt)));
      });
      setTimeout(hide, MAX_MS);
    })();
  </script>

  <!-- Botão de TEMA — inline pra não tocar no app.js da V2. Mesma chave e
       mesma lógica do script pré-paint no <head>. -->
  <script>
    (function () {
      var KEY = "bradesco_modal_card_theme";
      var $ = function (id) { return document.getElementById(id); };
      function apply(theme) {
        document.documentElement.setAttribute("data-theme", theme);
        var moon = $("theme-icon-moon"), sun = $("theme-icon-sun"), lbl = $("theme-label");
        if (moon) moon.classList.toggle("hidden", theme === "dark");
        if (sun)  sun.classList.toggle("hidden", theme !== "dark");
        if (lbl)  lbl.textContent = theme === "dark" ? "Claro" : "Escuro"; // mostra a AÇÃO
      }
      apply(document.documentElement.getAttribute("data-theme") || "light");
      var btn = $("btn-theme-toggle");
      if (btn) btn.addEventListener("click", function () {
        var current = document.documentElement.getAttribute("data-theme") || "light";
        var next = current === "dark" ? "light" : "dark";
        apply(next);
        try { localStorage.setItem(KEY, next); } catch (_) {}
      });
    })();
  </script>

  <!-- ---------- PAINEL DE PRÉ-VISUALIZAÇÃO (comportamento) ----------
       Não altera o app.js: escuta os MESMOS eventos das dropzones (change do
       input, drop na zona e clique no "×"), que chegam aos dois ouvintes. A
       imagem vem de um object URL próprio, revogado a cada troca para não
       vazar memória. Para ampliar, reaproveita o #modal-lightbox que já existe
       (inclusive o fechamento, que o app.js liga em todo [data-close]). -->
  <script>
    (function () {
      var painel = document.getElementById("preview-strip");
      if (!painel) return;

      var figura = document.getElementById("ps-figura") || document.getElementById("ps-figure");
      var imagem = document.getElementById("ps-img");
      var nome = document.getElementById("ps-name");
      var meta = document.getElementById("ps-meta");
      var chipXlsx = document.getElementById("ps-chip-xlsx");
      var nomeXlsx = document.getElementById("ps-xlsx-name");
      var chipPronto = document.getElementById("ps-chip-ready");
      var textoPronto = document.getElementById("ps-ready-text");

      var escolhidos = { xlsx: false, image: false };
      var arquivoImagem = null;
      var urlAtual = null;

      function peso(bytes) {
        return bytes < 1048576 ? Math.round(bytes / 1024) + " KB" : (bytes / 1048576).toFixed(1) + " MB";
      }
      function encurtar(texto, limite) {
        if (texto.length <= limite) return texto;
        var ponto = texto.lastIndexOf(".");
        var ext = ponto > -1 ? texto.slice(ponto) : "";
        return texto.slice(0, limite - ext.length - 1) + "…" + ext;
      }
      function revisarProntidao() {
        var faltam = (escolhidos.xlsx ? 0 : 1) + (escolhidos.image ? 0 : 1);
        chipPronto.classList.toggle("ready", faltam === 0);
        textoPronto.textContent = faltam === 0
          ? "pronto — clique em EXECUTAR"
          : faltam === 1 ? "falta 1 arquivo" : "faltam 2 arquivos";
      }
      function definirImagem(arquivo) {
        arquivoImagem = arquivo && /^image\//.test(arquivo.type) ? arquivo : null;
        escolhidos.image = !!arquivo;
        if (urlAtual) { URL.revokeObjectURL(urlAtual); urlAtual = null; }

        if (arquivoImagem) {
          urlAtual = URL.createObjectURL(arquivoImagem);
          imagem.src = urlAtual;
          painel.classList.add("has-image");
          nome.textContent = encurtar(arquivoImagem.name, 34);
          figura.title = "Ampliar " + arquivoImagem.name;
          var teste = new Image();
          teste.onload = function () {
            var tipo = (arquivoImagem.type.split("/")[1] || "").toUpperCase();
            meta.textContent = teste.naturalWidth + " × " + teste.naturalHeight + " px · " + peso(arquivoImagem.size) + (tipo ? " · " + tipo : "");
          };
          teste.src = urlAtual;
        } else {
          painel.classList.remove("has-image");
          imagem.removeAttribute("src");
          figura.title = "Selecionar a imagem de pesquisa";
          nome.textContent = arquivo ? encurtar(arquivo.name, 34) : "nenhuma imagem ainda";
          meta.textContent = arquivo ? "formato sem pré-visualização" : "arraste o arquivo na área abaixo";
        }
        revisarProntidao();
      }
      function definirExcel(arquivo) {
        escolhidos.xlsx = !!arquivo;
        chipXlsx.classList.toggle("done", !!arquivo);
        nomeXlsx.textContent = arquivo ? encurtar(arquivo.name, 26) + " · " + peso(arquivo.size) : "planilha pendente";
        revisarProntidao();
      }
      function espionar(idZona, idInput, idLimpar, aplicar) {
        var zona = document.getElementById(idZona);
        var input = document.getElementById(idInput);
        var limpar = document.getElementById(idLimpar);
        if (input) input.addEventListener("change", function (e) {
          if (e.target.files && e.target.files[0]) aplicar(e.target.files[0]);
        });
        if (zona) zona.addEventListener("drop", function (e) {
          if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) aplicar(e.dataTransfer.files[0]);
        });
        if (limpar) limpar.addEventListener("click", function () { aplicar(null); });
      }
      espionar("dz-xlsx", "input-xlsx", "dz-xlsx-clear", definirExcel);
      espionar("dz-image", "input-image", "dz-image-clear", definirImagem);

      // Com imagem: amplia no lightbox existente. Sem imagem: abre o seletor,
      // clicando no próprio botão da dropzone (nenhuma lógica duplicada).
      figura.addEventListener("click", function () {
        if (arquivoImagem && urlAtual) {
          document.getElementById("lightbox-img").src = urlAtual;
          document.getElementById("lightbox-caption").textContent = "Imagem de pesquisa · " + arquivoImagem.name;
          document.getElementById("modal-lightbox").classList.remove("hidden");
        } else {
          var botao = document.getElementById("dz-image-btn");
          if (botao) botao.click();
        }
      });

      revisarProntidao();
    })();
  </script>

  <!-- Sincronia de acessibilidade das ABAS — inline, como o loader e o tema.
       O app.js cuida da classe .active; aqui só espelhamos esse estado em
       aria-selected/tabindex e habilitamos as setas ←/→ do teclado. -->
  <script>
    (function () {
      var abas = Array.prototype.slice.call(document.querySelectorAll('.tabs [role="tab"]'));
      if (!abas.length) return;
      function espelhar() {
        abas.forEach(function (aba) {
          var ativa = aba.classList.contains("active");
          aba.setAttribute("aria-selected", String(ativa));
          aba.tabIndex = ativa ? 0 : -1;
        });
      }
      abas.forEach(function (aba, i) {
        aba.addEventListener("click", function () { setTimeout(espelhar, 0); });
        aba.addEventListener("keydown", function (evento) {
          var passo = evento.key === "ArrowRight" ? 1 : evento.key === "ArrowLeft" ? -1 : 0;
          if (!passo) return;
          evento.preventDefault();
          var alvo = abas[(i + passo + abas.length) % abas.length];
          alvo.focus(); alvo.click();
        });
      });
      espelhar();
    })();
  </script>

  <!-- type="module" permite import/export entre app.js e imageProcessor.js -->
  <script type="module" src="app.js"></script>
